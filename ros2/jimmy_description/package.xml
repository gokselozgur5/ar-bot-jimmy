  <version>0.1.0</version>
  <description>38 cm Full-Body 3-Pivot URDF/Xacro and RViz2 launch for Jimmy AR Companion</description>
  <maintainer email="gokselozgur5@gmail.com">Goksel Ozgur</maintainer>
